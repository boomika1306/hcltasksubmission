{
  "info": {
    "_postman_id": "893c5d88-7f99-4c12-9860-2df5e08b1a32",
    "name": "LivePoll - Real-Time Interactive Polling API",
    "description": "Comprehensive Postman API Collection for LivePoll internship developer evaluation. Tests Signup, Login, Poll CRUD, Real-Time Voting, and MongoDB Admin Diagnostics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "pollCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "pollId",
      "value": "",
      "type": "string"
    },
    {
      "key": "optionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verifies MongoDB and Redis connection status"
      }
    },
    {
      "name": "1. User Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "    console.log('Token saved:', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Intern Evaluator\",\n  \"email\": \"evaluator@example.com\",\n  \"password\": \"secret123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/signup",
          "host": ["{{baseUrl}}"],
          "path": ["signup"]
        }
      }
    },
    {
      "name": "2. User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "    console.log('Login token saved');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"evaluator@example.com\",\n  \"password\": \"secret123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      }
    },
    {
      "name": "3. Create Poll (Auth Required)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.code) {",
              "    pm.collectionVariables.set('pollCode', jsonData.code);",
              "    pm.collectionVariables.set('pollId', jsonData.id);",
              "    if (jsonData.options && jsonData.options.length > 0) {",
              "        pm.collectionVariables.set('optionId', jsonData.options[0].id);",
              "    }",
              "    console.log('Poll created code:', jsonData.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Which backend technology is best suited for high-concurrency real-time systems?\",\n  \"options\": [\n    \"Go (Golang) + Gin\",\n    \"Node.js + Express\",\n    \"Rust + Actix\",\n    \"Python + FastAPI\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/polls",
          "host": ["{{baseUrl}}"],
          "path": ["polls"]
        }
      }
    },
    {
      "name": "4. Get Poll by Code (Public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/polls/{{pollCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["polls", "{{pollCode}}"]
        }
      }
    },
    {
      "name": "5. Cast Vote (Atomic MongoDB + Redis Pub/Sub)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"optionId\": \"{{optionId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/polls/{{pollCode}}/vote",
          "host": ["{{baseUrl}}"],
          "path": ["polls", "{{pollCode}}", "vote"]
        }
      }
    },
    {
      "name": "6. Get My Polls (Auth Required)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/my-polls",
          "host": ["{{baseUrl}}"],
          "path": ["my-polls"]
        }
      }
    },
    {
      "name": "7. DB Stats & Redis Diagnostic (Admin View)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/db-stats",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "db-stats"]
        }
      }
    },
    {
      "name": "8. Inspect MongoDB Documents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/collections/polls",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "collections", "polls"]
        }
      }
    },
    {
      "name": "9. Delete Poll (Auth Required)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/polls/{{pollId}}",
          "host": ["{{baseUrl}}"],
          "path": ["polls", "{{pollId}}"]
        }
      }
    }
  ]
}
